# Copy to .env (gitignored). Never commit real keys.

# Network
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer / relayer for `npm run e2e -- --testnet` (fund it from https://faucet.monad.xyz)
DEPLOYER_PRIVATE_KEY=

# Optional: reuse an agent hot key instead of generating one
AGENT_PRIVATE_KEY=

# Web console (apps/web/.env.local or Vercel project settings)
NEXT_PUBLIC_AGENT_MANDATES_ADDRESS=
NEXT_PUBLIC_DEMO_AGENT=
NEXT_PUBLIC_DEMO_AGENT_ID=
NEXT_PUBLIC_DEMO_TARGET=
# Server-only: gas relayer key and optional demo vault sponsorship cap (wei)
RELAYER_PRIVATE_KEY=
RELAYER_SPONSOR_MAX_WEI=0

# v1 (MandateManager) addresses, kept for the recorded testnet evidence
NEXT_PUBLIC_MANDATE_MANAGER_ADDRESS=0x3550f9fc84640a9cfd7c51330615a1e05cb948be
ERC8004_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
