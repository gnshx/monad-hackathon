{
  "name": "agenttrust-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:sdk": "npm run --workspace=@agenttrust/sdk build",
    "test:sdk": "npm run --workspace=@agenttrust/sdk test",
    "build:agent": "npm run --workspace=@agenttrust/demo-agent build",
    "build:web": "npm run --workspace=@agenttrust/web build",
    "demo": "npx -y tsx scripts/run-demo.ts",
    "verify:p256": "npx -y tsx scripts/verify-p256-testnet.ts",
    "verify:erc8004": "npx -y tsx scripts/verify-erc8004-testnet.ts",
    "verify:tx": "npx -y tsx scripts/verify-tx.ts",
    "verify:all": "npx -y tsx scripts/verify-all-testnet.ts",
    "deploy:testnet": "npx -y tsx scripts/deploy-and-run-testnet.ts",
    "test:auditor": "npx tsx --test scripts/verify-all-testnet.test.ts"
  }
}
